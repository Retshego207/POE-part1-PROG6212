@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container py-5">
    <h1>Participant Dashboard</h1>
    <p class="text-muted">
        Welcome, @Context.Session.GetString("FirstName")!
        Your next RaceDay adventure starts here.
    </p>

    <div class="row g-4 mt-3">
        <div class="col-md-4">
            <div class="card shadow-sm p-4">
                <h4>Browse Events</h4>
                <p>Discover upcoming running, walking and cycling events.</p>
                <a href="#" class="btn btn-primary">Explore Events</a>
            </div>
        </div>

        <a asp-controller= "Participant"
           asp-action="Enrollment"
           class="btn btn-primary">
       </a>

       <a asp-controller="Participant"
          asp-action="Profile"
          class="btn btn-outline-primary">
      </a>

      <a asp-controller="Participant"
         asp-action="Result"
         class="btn btn-outline-primary">
     </a>

        <div class="col-md-4">
            <div class="card shadow-sm p-4">
                <h4>My Enrolments</h4>
                <p>Keep track of your event registrations.</p>
                <a href="#" class="btn btn-primary">My Enrolments</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-4">
                <h4>My Results</h4>
                <p>View your race results and performance.</p>
                <a href="#" class="btn btn-primary">View Results</a>
            </div>
        </div>
    </div>
</div>