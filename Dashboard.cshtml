@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h1>Organiser Dashboard</h1>
        <p class="text-muted">Welcome to your RaceDay organiser portal.</p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h4>Manage Events</h4>
                    <p>Create, update and delete race events.</p>
                    <a asp-controller="Organiser"
                       asp-action="Events"
                       class="btn btn-primary">
                        View Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h4>Manage Categories</h4>
                    <p>Create and manage event categories.</p>
                    <a asp-controller="Organiser"
                       asp-action="Categories"
                       class="btn btn-primary">
                        View Categories
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h4>Manage Enrolments</h4>
                    <p>View participant enrolments and enter race results.</p>
                    <a asp-controller="Organiser"
                       asp-action="Enrolments"
                       class="btn btn-primary">
                        View Enrolments
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>