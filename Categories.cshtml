@model List<RaceDayMVC.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="container py-5">
    <h2>Manage Event Categories</h2>
    <p class="text-muted">Organise the different types of RaceDay events.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning">@ViewBag.Error</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <a asp-action="CreateCategory" class="btn btn-primary mb-3">
        Create Category
    </a>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Category ID</th>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.categoryID</td>
                            <td>@item.categoryName</td>
                            <td>@item.description</td>
                            <td>
                                <a asp-action="EditCategory"
                                   asp-route-id="@item.categoryID"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <form asp-action="DeleteCategory"
                                      asp-route-id="@item.categoryID"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger"
                                            onclick="return confirm('Delete this category?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No categories found.</div>
    }
</div>