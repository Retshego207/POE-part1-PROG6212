@model List<RaceDayMVC.Models.ResultViewModel>

@{
    ViewData["Title"] = "Result";
}

<div class="container py-5">
    <h2>My Race Results</h2>
    <p class="text-muted">Track your race performance and achievements.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning">@ViewBag.Error</div>
    }

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Event Date</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                        <th>Average Pace</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.eventName</td>
                            <td>
                                @(item.eventDate == DateTime.MinValue
                                                        ? "Not available"
                                                        : item.eventDate.ToString("dd MMM yyyy"))
                    </td>
                    <td>@(item.finishTime?.ToString() ?? "Pending")</td>
                    <td>@(item.finishPosition?.ToString() ?? "Pending")</td>
                    <td>@(item.averagePace ?? "Not available")</td>
                    <td>@item.resultStatus</td>
                </tr>
                                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No race results are available yet.
        </div>
    }
</div>