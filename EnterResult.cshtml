@model RaceDayMVC.Models.ResultViewModel

@{
    ViewData["Title"] = "Enter Race Result";
}

<div class="container py-5">
    <h2>Enter Participant Result</h2>
    <p class="text-muted">Record the participant's race performance.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form asp-action="EnterResult" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="enrollmentID" />

        <div class="mb-3">
            <label asp-for="finishTime" class="form-label">Finish Time</label>
            <input asp-for="finishTime"
                   type="time"
                   step="1"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="finishPosition" class="form-label">Finish Position</label>
            <input asp-for="finishPosition"
                   type="number"
                   min="1"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="averagePace" class="form-label">Average Pace</label>
            <input asp-for="averagePace"
                   class="form-control"
                   placeholder="e.g. 5:30 min/km" />
        </div>

        <div class="mb-3">
            <label asp-for="resultStatus" class="form-label">Result Status</label>
            <select asp-for="resultStatus" class="form-select">
                <option value="Completed">Completed</option>
                <option value="Pending">Pending</option>
                <option value="Disqualified">Disqualified</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Result
        </button>

        <a asp-action="Enrolments" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>