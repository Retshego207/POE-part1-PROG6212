@model RaceDayMVC.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow p-4">
                <h2 class="text-center">Welcome Back</h2>
                <p class="text-center text-muted">Log in to RaceDay</p>

                <div class="alert alert-info">
                    Login functionality is being connected to the RaceDay API.
                </div>

                <a asp-action="Register" class="btn btn-outline-primary w-100">
                    Create an account
                </a>
            </div>
        </div>
    </div>
</div>