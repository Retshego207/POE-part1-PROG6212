@model List<RaceDayMVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Browse Events";
}

<div class="container py-5">

    @if (TempData["Success"] != null)
    {
       <div class="alert alert-success">
          @TempData["Success"]
          </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <h2 class="mb-2">Discover RaceDay Events</h2>

    <p class="text-muted">
        Find your next running, walking or cycling event.
    </p>

    <input type="text"
           id="eventSearch"
           class="form-control mb-4"
           placeholder="Search events..." />

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4 event-card">

                <div class="card h-100 shadow-sm">
                    <div class="card-body">

                        <h5 class="card-title">
                            @item.eventName
                        </h5>

                        <p>
                            <strong>Date:</strong>
                            @item.eventDate.ToString("dd MMM yyyy")
                        </p>

                        <p>
                            <strong>Location:</strong>
                            @item.location
                        </p>

                        <p>
                            <strong>Distance:</strong>
                            @item.distance
                        </p>

                        <p>
                            <strong>Entry Fee:</strong>
                            R @item.entryFee
                        </p>

                        <a asp-controller="Participant"
                           asp-action="EventDetails"
                           asp-route-id="@item.eventID"
                           class="btn btn-primary">
                            View Details
                        </a>

                    </div>
                </div>

            </div>
        }

    </div>

    @if (!Model.Any())
    {
        <p class="alert alert-info">
            No events are currently available.
        </p>
    }

</div>

@section Scripts {
    <script>
        document.getElementById("eventSearch").addEventListener("input", function () {

            const search = this.value.toLowerCase();

            document.querySelectorAll(".event-card").forEach(card => {

                card.style.display =
                    card.innerText.toLowerCase().includes(search)
                    ? ""
                    : "none";

            });

        });
    </script>
}